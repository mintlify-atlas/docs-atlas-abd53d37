  "keyFeatures": [
    "WebRTC peer-to-peer audio/video recording with low-latency streaming",
    "Multipart S3 uploads with chunked transfer and retry logic",
    "Real-time signaling server (WebSocket) for room and meeting management",
    "Studio settings: recording type, audio sample rate, video quality, noise reduction",
    "Project and track management with PostgreSQL/Prisma data layer",
    "Google OAuth and credentials-based authentication via NextAuth.js",
    "Full Docker Compose deployment with health checks",
    "Turborepo monorepo with shared packages for types, database, and UI",
    "GitHub Actions CI/CD pipelines for frontend, backend, and signal services",
    "Media processing pipeline with Kafka queue integration"
  ],
